# Copy to .env.local and fill in.

# Long random string used to sign login cookies (required in production).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Database. Leave empty in development to use a local file (./data/cdg.db).
# In production use a hosted libSQL / Turso database:
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=
DATABASE_AUTH_TOKEN=
